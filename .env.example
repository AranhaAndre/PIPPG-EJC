# ====================================================================
# O ALVO É CRISTO · Doações — copie para .env e ajuste.
# NUNCA versione o .env real (já está no .gitignore).
# ====================================================================

# --- Identidade (aparece na página do doador) ------------------------
EVENT_NAME=O Alvo é Cristo
EVENT_SUBTITLE=Mocidade Presbiteriana de Ponta Grossa
EVENT_VERSE=Prossigo para o alvo, para o prêmio da soberana vocação de Deus em Cristo Jesus.
EVENT_VERSE_REF=Filipenses 3.14

# --- Acesso da coordenação (painel /admin) ---------------------------
ADMIN_USER=coordenacao
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Gere um segredo aleatório e cole aqui:  openssl rand -hex 32
SECRET_KEY=
TOKEN_TTL_HOURS=12
# true quando estiver atrás de HTTPS (produção). Em teste local http, use false.
COOKIE_SECURE=true

# --- PIX (deixe PIX_KEY vazio para esconder a seção) -----------------
# A chave pode ser CPF/CNPJ, e-mail, telefone (+55...) ou chave aleatória.
PIX_KEY=
PIX_NAME=Igreja Presbiteriana de Ponta Grossa
PIX_CITY=Ponta Grossa
PIX_DESCRIPTION=Doacao Mocidade
# Valor fixo opcional (ex.: 50.00). Vazio = o doador escolhe quanto doar.
PIX_AMOUNT=
# Aviso livre exibido ao lado do PIX (ex.: centavos identificadores da tesouraria).
PIX_NOTE=Prefere ajudar em dinheiro? Faça um PIX para a igreja.

# --- Banco (padrão: SQLite em volume persistente) --------------------
DATABASE_URL=sqlite+aiosqlite:////data/doacoes.db
